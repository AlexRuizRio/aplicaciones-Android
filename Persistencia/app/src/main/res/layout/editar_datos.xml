<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textView4"
        android:layout_width="412dp"
        android:layout_height="79dp"
        android:text="NOMBRE Y APELLIDOS"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="413dp"
        android:layout_height="86dp"
        android:text="EDITAR DATOS"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="208dp"
        android:layout_height="159dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Imagen de contacto"
        tools:srcCompat="@tools:sample/avatars" />

    <EditText
        android:id="@+id/editarnombre"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:ems="10"
        android:inputType="text"
        android:text="Nombre"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <EditText
        android:id="@+id/editarintereses"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:ems="10"
        android:inputType="text"
        android:text="Intereses"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editarnombre" />

    <Button
        android:id="@+id/salvarEditar"
        android:layout_width="191dp"
        android:layout_height="57dp"
        android:text="Salvar datos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editarintereses" />

    <Button
        android:id="@+id/atrasEditar"
        android:layout_width="208dp"
        android:layout_height="59dp"
        android:text="Salir sin guardar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/salvarEditar"
        app:layout_constraintTop_toBottomOf="@+id/editarintereses" />
</androidx.constraintlayout.widget.ConstraintLayout>